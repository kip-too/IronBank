<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Versions below were read from Maven Central metadata on 2026-09-14, not from memory:
      spring-boot-starter-parent 3.5.16 is the highest 3.x release
        (repo1.maven.org/maven2/org/springframework/boot/spring-boot-starter-parent/maven-metadata.xml)
      Flyway 11.7.2, pgjdbc 42.7.11, JUnit Jupiter 5.12.2 and AssertJ 3.27.7 are the versions
        that BOM manages, so they are deliberately NOT pinned here.
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <!--
    groupId is a single segment on purpose. This is an application, never published as a
    Maven artifact, so claiming a reverse-DNS group would assert ownership of a domain
    nobody here owns. Tied to SPEC.md O5 (repository name) - revisit if that answer changes.
  -->
  <groupId>shilingi</groupId>
  <artifactId>shilingi</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>shilingi</name>
  <description>Treasury and bookkeeping layer: KES functional, USDC foreign</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!--
      The one demonstration screen (SPEC.md section 2 and section 4). Needed to serve anything
      at all.

      Note what is NOT here: no template engine. SPEC.md section 3's technology table names none,
      and rule 6 makes every library a decision. One server-rendered page does not justify
      Thymeleaf, so DemoController writes its HTML with Java 21 text blocks.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <!-- Flyway 10+ splits database support out of flyway-core; PostgreSQL needs this artifact. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-postgresql</artifactId>
    </dependency>

    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Brings JUnit 5 and AssertJ, the two SPEC.md section 3 names. No Testcontainers: Docker is unavailable. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
